    <string name="lunaris_bar_appearance_theme">Tema dan latar belakang</string>
    <string name="lunaris_bar_appearance_chip">Cip ringkas</string>
    <string name="lunaris_bar_appearance_position">Posisi dan jarak kamera</string>
